<%- include('../../partials/header') %>
<main>
    <h1>Registered Users</h1>

    <% if (users.length > 0) { %>
        <div class="users-list">
            <% users.forEach(listUser => {
                // 'user' is the logged-in person (null for visitors); 'listUser' is the card being drawn
                const canEdit = Boolean(user) && (user.id === listUser.id || user.roleName === 'admin');
                const canDelete = Boolean(user) && user.roleName === 'admin' && user.id !== listUser.id;
            %>
                <div class="user-card">
                    <div class="user-header">
                        <h3><%= listUser.name %></h3>
                        <span>ID: <%= listUser.id %></span>
                    </div>
                    <div class="user-details">
                        <p>Email: <%= listUser.email %></p>
                        <p>Role: <%= listUser.roleName %></p>
                        <p>Registered: <%= new Date(listUser.created_at).toLocaleString() %></p>
                    </div>

                    <% if (canEdit || canDelete) { %>
                        <div class="user-actions">
                            <% if (canEdit) { %>
                                <a href="/register/<%= listUser.id %>/edit">Edit</a>
                            <% } %>
                            <% if (canDelete) { %>
                                <form method="POST" action="/register/<%= listUser.id %>/delete" class="inline-form">
                                    <button type="submit" onclick="return confirm('Are you sure you want to delete this user?')">Delete</button>
                                </form>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <p class="no-users">No users registered yet.</p>
    <% } %>

    <div class="navigation">
        <p><a href="/register">&larr; Back to Registration</a></p>
    </div>
</main>
<%- include('../../partials/footer') %>
