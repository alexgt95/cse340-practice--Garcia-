<%- include('../partials/header') %>
<main>
    <h1>Faculty Directory</h1>
    <p>Meet our faculty members and click any name to see their details.</p>

    <div class="sort-options">
        <span>Sort by: </span>
        <a href="/faculty?sort=name" class="<%= currentSort === 'name' ? 'active' : '' %>">Name</a>
        <a href="/faculty?sort=department" class="<%= currentSort === 'department' ? 'active' : '' %>">Department</a>
        <a href="/faculty?sort=title" class="<%= currentSort === 'title' ? 'active' : '' %>">Title</a>
    </div>

    <div class="course-list">
        <% faculty.forEach(member => { %>
            <div class="course-card faculty-card">
                <img src="/images/faculty/<%= member.slug %>.jpg" alt="<%= member.name %>" class="faculty-photo" onerror="this.onerror=null; this.src='https://placehold.co/480';">
                <h3><a href="/faculty/<%= member.slug %>"><%= member.name %></a></h3>
                <p><%= member.department %> • <%= member.title %></p>
            </div>
        <% }); %>
    </div>
</main>
<%- include('../partials/footer') %>
