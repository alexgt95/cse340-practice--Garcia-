<%- include('../partials/header') %>
<main>
    <div class="faculty-profile">
        <img src="/images/faculty/<%= faculty.slug %>.jpg" alt="<%= faculty.name %>" class="faculty-photo" onerror="this.onerror=null; this.src='https://placehold.co/480';">
        <div class="course-header">
            <h1><%= faculty.name %></h1>
            <p class="course-meta"><%= faculty.title %> • <%= faculty.department %></p>
        </div>
    </div>

    <div class="sections">
        <h2>Contact Information</h2>
        <div class="section-card">
            <div class="section-room">Office: <%= faculty.office %></div>
            <div class="section-room">Phone: <%= faculty.phone %></div>
            <div class="section-room">Email: <a href="mailto:<%= faculty.email %>"><%= faculty.email %></a></div>
        </div>
    </div>

    <div class="navigation">
        <p><a href="/faculty">&larr; Back to Faculty Directory</a></p>
    </div>
</main>
<%- include('../partials/footer') %>
